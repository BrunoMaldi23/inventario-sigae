# ============================================================
# API — Inventario Escolar
# Copie este archivo a .env y configure los valores reales.
# NUNCA suba .env al repositorio.
# ============================================================

# --- Base de datos PostgreSQL (fuente oficial de datos) ---
DATABASE_URL="postgresql://inventario:inventario_dev@localhost:5432/inventario_escolar?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET="cambiar-este-secreto-access"
JWT_REFRESH_SECRET="cambiar-este-secreto-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Orígenes CORS separados por coma
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# --- Almacenamiento local de adjuntos ---
STORAGE_PATH="./storage"

# --- Swagger ---
SWAGGER_ENABLED=true

# --- Throttling (login) ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=20